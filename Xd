-- ===================================================================
-- AGE OF HEROES - ULTRA POTATO & MAXIMUM FPS BOOST
-- ===================================================================

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local Terrain = Workspace:FindFirstChildOfClass("Terrain")

print("[POTATO BOOST] Aplicando optimización extrema...")

-- 1. CERO SOMBRAS Y CERO LUCES PESADAS
Lighting.GlobalShadows = false
Lighting.FogEnd = 9e9
Lighting.Brightness = 0
pcall(function()
    sethiddenproperty(Lighting, "Technology", Enum.RenderingTech.Compatibility)
end)

for _, v in ipairs(Lighting:GetChildren()) do
    pcall(function() v:Destroy() end)
end

-- 2. CERO TERRENO DETALLADO (Agua y decoración fuera)
if Terrain then
    Terrain.WaterWaveSize = 0
    Terrain.WaterWaveTransparency = 1
    Terrain.WaterTransparency = 1
    pcall(function()
        Terrain.Decoration = false
    end)
end

-- 3. FUNCIÓN DE PURGA (Mapeado plano, sin texturas, sin ropa, sin efectos)
local function potatoMode(obj)
    if obj:IsA("BasePart") then
        obj.Material = Enum.Material.SmoothPlastic
        obj.Reflectance = 0
        obj.CastShadow = false
        obj.CanCollide = false
    elseif obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("SpecialMesh") then
        pcall(function() obj:Destroy() end)
    elseif obj:IsA("Clothing") or obj:IsA("ShirtGraphic") or obj:IsA("Accessory") then
        pcall(function() obj:Destroy() end) -- Elimina la ropa y accesorios por completo
    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Beam") or obj:IsA("Light") or obj:IsA("Explosion") then
        pcall(function() obj:Destroy() end) -- Elimina al instante cualquier efecto de habilidad o luz
    end
end

-- Limpieza masiva de todo lo que ya está en el mapa
for _, obj in ipairs(Workspace:GetDescendants()) do
    potatoMode(obj)
end

-- Limpieza en tiempo real para cualquier ataque o mapa nuevo que cargue
Workspace.DescendantAdded:Connect(function(obj)
    task.spawn(function()
        potatoMode(obj)
    end)
end)

-- 4. DESNUDAR Y LIMPIAR A LOS JUGADORES (Cero ropa, cero accesorios)
local function cleanPlayer(player)
    if player.Character then
        for _, part in ipairs(player.Character:GetDescendants()) do
            potatoMode(part)
        end
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= Players.LocalPlayer then
        cleanPlayer(player)
        player.CharacterAdded:Connect(function()
            task.wait(0.05)
            cleanPlayer(player)
        end)
    end
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.05)
        cleanPlayer(player)
    end)
end)

-- 5. FORZAR LA CALIDAD GRÁFICA AL MÍNIMO ABSOLUTO DE ROBLOX
pcall(function()
    settings().Rendering.QualityLevel = 1
    UserSettings().GameSettings.SavedQualityLevel = Enum.SavedQualityLevel.Level1
end)

print("[POTATO BOOST] ¡Listo! Gráficos de patata extremos activados.")
